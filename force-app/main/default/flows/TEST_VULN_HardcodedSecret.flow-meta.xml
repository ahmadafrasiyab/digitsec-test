<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <label>TEST VULN - Hardcoded Secret</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <interviewLabel>TEST VULN - Hardcoded Secret {!$Flow.CurrentDateTime}</interviewLabel>


    
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Store_Auth_Header_On_Account</targetReference>
        </connector>
        <object>Account</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>

    <!-- VULNERABILITY (SFDC_FLOW_HARDCODED_SECRET): -->
    <!-- an API key/token literal is hardcoded directly into a flow variable's -->
    <!-- default value rather than being retrieved from Named Credentials, a -->
    <!-- Custom Metadata Type, or Protected Custom Setting. Hardcoded secrets in -->
    <!-- Flow metadata are visible to anyone with read access to the flow -->
    <!-- (including via change sets, unmanaged package exports, or the Setup UI -->
    <!-- flow definition view) and cannot be rotated without a deployment. -->
    <variables>
        <name>ExternalServiceApiKey</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>EXAMPLE-HARDCODED-API-KEY-PLACEHOLDER-000000</stringValue>
        </value>
    </variables>

    <!-- Also flagged: a hardcoded value baked directly into a formula, -->
    <!-- rather than referencing a secure external source. -->
    <formulas>
        <name>AuthHeaderFormula</name>
        <dataType>String</dataType>
        <expression>"Bearer EXAMPLE-HARDCODED-API-KEY-PLACEHOLDER-000000"</expression>
    </formulas>

    <!-- Simulates the secret being used/persisted downstream - here written to -->
    <!-- a text field so the scanner can trace the hardcoded value being -->
    <!-- consumed, without depending on an actual External Service callout -->
    <!-- (which requires org-specific setup and isn't needed to trip this rule). -->
    <recordUpdates>
        <name>Store_Auth_Header_On_Account</name>
        <label>Store Auth Header On Account</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>AuthHeaderFormula</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
</Flow>
