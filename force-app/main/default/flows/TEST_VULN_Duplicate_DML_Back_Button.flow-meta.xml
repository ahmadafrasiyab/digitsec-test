<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <label>TEST VULN - Duplicate DML (Back Button)</label>
    <processType>Flow</processType>
    <status>Active</status>
    <interviewLabel>TEST_VULN_Duplicate_DML_Back Button {!$Flow.CurrentDateTime}</interviewLabel>

    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Update_Case_Status</targetReference>
        </connector>
    </start>

    <!-- VULNERABILITY (SFDC_FLOW_DUPLICATE_DML / DuplicateDMLOperation): -->
    <!-- This DML update runs, then immediately routes to a screen with -->
    <!-- allowBack + showFooter enabled. If the user clicks Back and then -->
    <!-- Next again, this Update element re-executes for the same record. -->
    <recordUpdates>
        <name>Update_Case_Status</name>
        <label>Update Case Status</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <connector>
            <targetReference>Confirmation_Screen</targetReference>
        </connector>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>In Progress</stringValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>

    <!-- The DML above already ran when this screen is reached. Because -->
    <!-- allowBack is true, the user can navigate back to a prior screen -->
    <!-- and then forward again, re-running Update_Case_Status. -->
    <screens>
        <name>Confirmation_Screen</name>
        <label>Confirmation Screen</label>
        <locationX>176</locationX>
        <locationY>266</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
        <fields>
            <name>Confirmation_Text</name>
            <fieldText>The case status has been updated.</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
    </screens>
</Flow>