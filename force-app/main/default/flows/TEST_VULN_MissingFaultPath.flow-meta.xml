<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <label>TEST VULN - Missing Fault Path</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <interviewLabel>TEST VULN - Missing Fault Path {!$Flow.CurrentDateTime}</interviewLabel>

    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Create_Task</targetReference>
        </connector>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>

    <!-- VULNERABILITY (SFDC_FLOW_MISSING_FAULT_PATH): -->
    <!-- this Create DML element has no <faultConnector> defined. If the DML -->
    <!-- fails (validation rule, trigger exception, required field missing, -->
    <!-- storage limit, etc.) the flow simply throws an unhandled fault, the -->
    <!-- transaction rolls back with a generic/unfriendly error, and there is -->
    <!-- no logging, retry, or user-facing message describing what happened. -->
    <recordCreates>
    
        <name>Create_Task</name>
        <label>Create Task</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <connector>
            <targetReference>Update_Opportunity_Flag</targetReference>
        </connector>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Follow up on Opportunity</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>

    <!-- Second DML element, also missing a fault path -->
    <recordUpdates>
        <name>Update_Opportunity_Flag</name>
        <label>Update Opportunity Flag</label>
        <locationX>176</locationX>
        <locationY>266</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>Follow-up task created</stringValue>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
</Flow>
