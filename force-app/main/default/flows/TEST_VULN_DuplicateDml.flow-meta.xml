<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <label>TEST VULN - Duplicate DML</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <interviewLabel>TEST VULN - Duplicate DML {!$Flow.CurrentDateTime}</interviewLabel>

    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Update_Status_Field</targetReference>
        </connector>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>

    <!-- VULNERABILITY (SFDC_FLOW_DUPLICATE_DML): -->
    <!-- this Update and the one below both perform DML on the same triggering -->
    <!-- Case record in sequence, one field at a time, instead of being merged -->
    <!-- into a single Update element that sets both fields at once. Each extra -->
    <!-- DML statement consumes part of the 150-per-transaction governor limit -->
    <!-- and can also trigger duplicate save-order/recursion issues. -->
    <recordUpdates>
        <name>Update_Status_Field</name>
        <label>Update Status Field</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <connector>
            <targetReference>Update_Priority_Field</targetReference>
        </connector>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>In Progress</stringValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>

    <!-- Second, separate DML statement on the exact same record - should have -->
    <!-- been combined with Update_Status_Field above into one element. -->
    <recordUpdates>
        <name>Update_Priority_Field</name>
        <label>Update Priority Field</label>
        <locationX>176</locationX>
        <locationY>266</locationY>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
</Flow>
