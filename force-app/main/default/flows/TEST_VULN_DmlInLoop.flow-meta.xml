<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <label>TEST VULN - DML In Loop</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <interviewLabel>TEST VULN - DML In Loop {!$Flow.CurrentDateTime}</interviewLabel>

    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Get_Contacts</targetReference>
        </connector>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>

    <recordLookups>
        <name>Get_Contacts</name>
        <label>Get Contacts</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <connector>
            <targetReference>Loop_Contacts</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <loops>
        <name>Loop_Contacts</name>
        <label>Loop Contacts</label>
        <locationX>176</locationX>
        <locationY>266</locationY>
        <collectionReference>Get_Contacts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <!-- VULNERABILITY (SFDC_FLOW_DML_IN_LOOP): -->
        <!-- the loop's "next" path feeds directly into an Update DML element -->
        <!-- below, meaning one Update statement fires PER ITERATION instead of -->
        <!-- collecting records into a list and updating once after the loop. -->
        <!-- This risks hitting the 150 DML statements per transaction limit -->
        <!-- on any account with more than 150 related contacts. -->
        <nextValueConnector>
            <targetReference>Update_Contact_In_Loop</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Loop_End</targetReference>
        </noMoreValuesConnector>
    </loops>

    <recordUpdates>
        <name>Update_Contact_In_Loop</name>
        <label>Update Contact In Loop</label>
        <locationX>176</locationX>
        <locationY>374</locationY>
        <connector>
            <targetReference>Loop_Contacts</targetReference>
        </connector>
        <inputReference>Loop_Contacts</inputReference>
    </recordUpdates>

    <recordUpdates>
        <name>Loop_End</name>
        <label>Loop End (no-op passthrough)</label>
        <locationX>176</locationX>
        <locationY>482</locationY>
        <inputAssignments>
            <field>Id</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
</Flow>
